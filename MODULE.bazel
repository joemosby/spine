module(
    name = "spine",
    version = "0.0.0",
)

# C++ rules live in rules_cc (Bazel 9 no longer ships them). No product
# cc_* targets in Phase 0; this dep is the BCR hook for later Runtime code.
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.1.0")

# Fetched LLVM compiler (not host gcc/clang). Native links still use the
# host sysroot unless a sysroot is added later. See README.
bazel_dep(name = "toolchains_llvm", version = "1.8.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "19.1.7",
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")
